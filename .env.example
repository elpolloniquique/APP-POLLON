VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_STORAGE_BUCKET=product-images
VITE_WHATSAPP_DEFAULT=56986925310
VITE_LEGACY_ADMIN_PASSWORD=
# OSRM routing (gratis). En producción usa tu instancia self-host.
# Demo público: https://router.project-osrm.org
VITE_OSRM_URL=https://router.project-osrm.org

# --- Web Push repartidores (bandeja del sistema) ---
# Generar: npx web-push generate-vapid-keys
# En Vercel también: VAPID_PRIVATE_KEY, VAPID_SUBJECT, SUPABASE_SERVICE_ROLE_KEY
# SQL: supabase/fix-driver-push-subscriptions.sql
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@el-pollon.cl
SUPABASE_SERVICE_ROLE_KEY=

VITE_PUBLIC_SITE_URL=https://www.el-pollon.cl

# --- El Pollón Bot (SIN IA, SIN Meta Cloud API) ---
# SQL: supabase/fase4-pollon-bot.sql
# Docs: docs/WHATSAPP_BOT.md + docs/WHATSAPP_BOT_IMPLEMENTATION_PLAN.md
# Bucket privado de documentos del bot (no es VITE: el front usa el cliente auth).
# BOT_STORAGE_BUCKET=bot-documents

# Simulador BotEngine (FASE 5): POST /api/bot-simulate
# BOT_SIMULATE_SECRET=   (si vacío, usa EP_WA_WEBHOOK_SECRET)

# Evolution (open source, $0) — solo backend / FASE 15. Requiere host persistente.
# No uses trycloudflare en producción. No Meta Cloud API. No subas claves a GitHub.
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE_NAME=pollon-bot
# EP_WA_WEBHOOK_SECRET=
# BOT_DISPATCH_SECRET=
# CRON_SECRET=

# Webhook inbound del bot (Evolution → Vercel):
#   https://www.el-pollon.cl/api/bot-wa-inbound?secret=EP_WA_WEBHOOK_SECRET
# Database Webhook pedidos (Supabase → Vercel):
#   https://www.el-pollon.cl/api/bot-order-hook?secret=EP_WA_WEBHOOK_SECRET
# Cola avisos (cron / manual):
#   https://www.el-pollon.cl/api/bot-dispatch-queue?secret=EP_WA_WEBHOOK_SECRET
